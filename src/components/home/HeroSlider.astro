---
import { Icon } from 'astro-icon/components'

interface Slide {
	desktop: string
	mobile: string
	alt: string
	eyebrow?: string
	title?: string
	description?: string
	cta?: {
		label: string
		href: string
	}
}

const slides: Slide[] = [
	{
		desktop: '/assets/images/keyboards-desktop.png',
		mobile: '/assets/images/keyboards-mobile.png',
		alt: 'Teclados mecánicos Keychron, Nuphy y similares',
		eyebrow: 'Teclados mecánicos',
		title: 'Siente cada pulsación',
		description:
			'Keychron, Nuphy y más. Teclados inalámbricos, hot-swap y RGB listos para llevar tu escritorio al siguiente nivel.',
		cta: {
			label: 'Ver teclados',
			href: '/productos/keyboards',
		},
	},

	{
		desktop: '/assets/images/keyboard-accesories-desktop.png',
		mobile: '/assets/images/keyboard-accesories-mobile.png',
		alt: 'Accesorios para teclados Keychron, Nuphy y similares',
		eyebrow: 'Accesorios',
		title: 'Personaliza tu experiencia',
		description:
			'Interruptores, Teclas, Reposamanos y más. Todo lo que necsitas para crear tu setup ideal.',
		cta: {
			label: 'Ver Accesorios',
			href: '/productos/keyboards',
		},
	},
]

const brands = ['Keychron', 'Nuphy', 'Logitech', 'Akko']
---

<section
	class="hero relative h-[100svh] max-h-[1000px] min-h-[560px] w-full overflow-hidden bg-black text-white">
	<div class="hero-embla h-full">
		<div class="hero-embla__viewport h-full overflow-hidden">
			<div class="hero-embla__container flex h-full">
				{
					slides.map((slide, index) => (
						<div class="hero-embla__slide relative h-full min-w-0 flex-[0_0_100%]">
							<picture>
								<source media="(min-width: 1024px)" srcset={slide.desktop} />
								<img
									class="absolute inset-0 h-full w-full object-cover object-center"
									src={slide.mobile}
									alt={slide.alt}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'auto'}
								/>
							</picture>

							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/50" />

							<div class="relative z-10 mx-auto flex h-full w-full max-w-[1200px] flex-col justify-end px-6 pb-24 md:pb-28 lg:px-10">
								{slide.eyebrow && (
									<span class="mb-3 w-fit rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-medium tracking-[0.2em] uppercase backdrop-blur-sm">
										{slide.eyebrow}
									</span>
								)}

								{slide.title && (
									<h1 class="max-w-3xl text-4xl font-bold text-balance sm:text-5xl lg:text-6xl">
										{slide.title}
									</h1>
								)}

								{slide.description && (
									<p class="mt-4 max-w-xl text-sm text-white/80 text-pretty sm:text-base">
										{slide.description}
									</p>
								)}

								{slide.cta && (
									<a
										href={slide.cta.href}
										class="mt-8 w-fit rounded-md bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-lg transition-transform duration-150 hover:-translate-y-0.5">
										{slide.cta.label}
									</a>
								)}

								<ul class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-semibold tracking-[0.15em] text-white/60 uppercase">
									{brands.map((brand) => (
										<li>{brand}</li>
									))}
								</ul>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<!-- Slider navigation (over the slider) -->
	<div
		data-hero-nav
		class="hero-nav pointer-events-none absolute inset-x-0 top-1/2 z-20 hidden -translate-y-1/2 justify-between px-4 md:flex lg:px-8">
		<button
			type="button"
			data-hero-prev
			aria-label="Diapositiva anterior"
			class="hero-arrow pointer-events-auto">
			<Icon name="tabler:chevron-left" size={26} />
		</button>
		<button
			type="button"
			data-hero-next
			aria-label="Diapositiva siguiente"
			class="hero-arrow pointer-events-auto">
			<Icon name="tabler:chevron-right" size={26} />
		</button>
	</div>

	<div
		data-hero-nav
		data-hero-dots
		class="hero-dots absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2">
	</div>
</section>

<style>
	.hero-embla__container {
		touch-action: pan-y pinch-zoom;
	}

	.hero-embla__slide {
		transform: translate3d(0, 0, 0);
	}

	.hero-arrow {
		display: inline-flex;
		height: 3rem;
		width: 3rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid oklch(100% 0 0 / 0.3);
		background: oklch(0% 0 0 / 0.3);
		color: oklch(100% 0 0 / 0.9);
		backdrop-filter: blur(8px);
		cursor: pointer;
		transition:
			background 0.15s ease,
			opacity 0.15s ease;
	}

	.hero-arrow:hover {
		background: oklch(0% 0 0 / 0.55);
	}

	.hero-arrow:disabled {
		opacity: 0.25;
		cursor: default;
	}

	.hero-dots {
		pointer-events: auto;
	}

	.hero-dot {
		height: 0.5rem;
		width: 0.5rem;
		border-radius: 9999px;
		background: oklch(100% 0 0 / 0.4);
		cursor: pointer;
		transition:
			width 0.2s ease,
			background 0.2s ease;
	}

	.hero-dot[data-active] {
		width: 1.75rem;
		background: oklch(var(--primary));
	}

	[data-hero-nav][data-hidden] {
		display: none;
	}
</style>

<script>
	import EmblaCarousel from 'embla-carousel'

	const initHeroSlider = () => {
		const root = document.querySelector('.hero-embla') as HTMLElement | null
		if (!root) return

		const viewport = root.querySelector('.hero-embla__viewport') as HTMLElement
		const slideCount = viewport.querySelectorAll('.hero-embla__slide').length
		const prevBtn = document.querySelector('[data-hero-prev]') as HTMLButtonElement | null
		const nextBtn = document.querySelector('[data-hero-next]') as HTMLButtonElement | null
		const dotsNode = document.querySelector('[data-hero-dots]') as HTMLElement | null
		const navNodes = document.querySelectorAll<HTMLElement>('[data-hero-nav]')

		const embla = EmblaCarousel(viewport, { loop: slideCount > 1, align: 'start' })

		const syncDots = () => {
			if (!dotsNode) return
			const selected = embla.selectedScrollSnap()
			Array.from(dotsNode.children).forEach((dot, index) => {
				dot.toggleAttribute('data-active', index === selected)
			})
		}

		const syncControls = () => {
			const multiple = embla.scrollSnapList().length > 1
			if (prevBtn) prevBtn.disabled = !embla.canScrollPrev() || !multiple
			if (nextBtn) nextBtn.disabled = !embla.canScrollNext() || !multiple
			navNodes.forEach((node) => node.toggleAttribute('data-hidden', !multiple))
		}

		const renderDots = () => {
			if (!dotsNode) return
			dotsNode.innerHTML = ''
			embla.scrollSnapList().forEach((_, index) => {
				const dot = document.createElement('button')
				dot.type = 'button'
				dot.className = 'hero-dot'
				dot.setAttribute('aria-label', `Ir a la diapositiva ${index + 1}`)
				dot.addEventListener('click', () => embla.scrollTo(index))
				dotsNode.appendChild(dot)
			})
			syncDots()
		}

		prevBtn?.addEventListener('click', () => embla.scrollPrev())
		nextBtn?.addEventListener('click', () => embla.scrollNext())

		embla.on('select', syncDots)
		embla.on('select', syncControls)
		embla.on('reInit', renderDots)
		embla.on('reInit', syncControls)

		renderDots()
		syncControls()
	}

	initHeroSlider()
</script>
